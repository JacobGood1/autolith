(in-package #:autolith)

;;;; -- Provider-qualified Model Selection --

(-> provider-selection-tests--factory
    (configuration &key (:reasoning-summaries-p boolean)) model-provider)
(defun provider-selection-tests--factory (configuration &key reasoning-summaries-p)
  "Construct an offline provider using the standard subscription lifecycle."
  (provider-family-create ':codex configuration :reasoning-summaries-p reasoning-summaries-p))

(-> provider-selection-tests--with-providers (function) null)
(defun provider-selection-tests--with-providers (function)
  "Run FUNCTION with colliding, slash-containing offline provider catalogs."
  (let ((snapshot (provider--registry-snapshot)))
    (unwind-protect
         (progn
           (dolist (spec '(("selection-a" 11000 "low" "high")
                           ("selection-b" 22000 "high")))
             (destructuring-bind (name window &rest efforts) spec
               (register-provider
                name :family ':codex
                :endpoint (format nil "https://~A.invalid/completions" name)
                :models (loop for model in '("shared" "hf:zai-org/GLM-5.3-Flash"
                                              "deepseek/deepseek-v4.1-flash-1017"
                                              "deepseek/v4")
                              collect (list :name model :context-window window
                                            :reasoning-efforts efforts))
                :factory #'provider-selection-tests--factory)))
           (register-provider "deepseek" :family ':codex :models '("v4")
                              :factory #'provider-selection-tests--factory)
           (funcall function))
      (provider--registry-restore snapshot)))
  nil)

(-> test-provider-qualified-model-resolution () null)
(defun test-provider-qualified-model-resolution ()
  "Resolve duplicate and slash IDs without changing the factory's model ID."
  (provider-selection-tests--with-providers
   (lambda ()
     (dolist (case '(("shared" nil "shared" "selection-b")
                     ("selection-a/shared" nil "shared" "selection-a")
                     ("shared" "selection-a" "shared" "selection-a")
                     ("selection-a/shared" "selection-a" "shared" "selection-a")
                     ("hf:zai-org/GLM-5.3-Flash" nil "hf:zai-org/GLM-5.3-Flash" "selection-b")
                     ("selection-a/deepseek/deepseek-v4.1-flash-1017" nil
                      "deepseek/deepseek-v4.1-flash-1017" "selection-a")
                     ("deepseek/v4" "selection-b" "deepseek/v4" "selection-b")))
       (destructuring-bind (selection provider expected-model expected-provider) case
         (multiple-value-bind (model registration)
             (provider-resolve-model selection :provider provider)
           (test-assert (and (equal model expected-model)
                             (equal (provider-registration-name registration) expected-provider))
                        "model resolution retains the exact ID and requested provider"))))
     (dolist (case '(("shared" "absent" :unknown-provider)
                     ("selection-a/shared" "selection-b" :provider-mismatch)
                      ("missing" "selection-a" :unsupported-model)
                      ("selection-a/missing" nil :unsupported-model)
                     ("deepseek/v4" nil :ambiguous-model)))
       (destructuring-bind (selection provider reason) case
         (test-assert
          (handler-case (progn (provider-resolve-model selection :provider provider) nil)
            (model-selection-error (condition)
              (and (eq (model-selection-error-reason condition) reason)
                   (equal (model-selection-error-model condition) selection))))
          "invalid selections have structured failure reasons")))
     (let* ((base (test-configuration))
            (root (test-configuration-root base)))
       (unwind-protect
             (progn
               (dolist (name '("selection-a" "selection-b"))
                 (let* ((configuration (configuration-copy base :model "shared" :model-provider name))
                        (provider (provider-create configuration))
                        (login (provider-authentication-provider configuration name)))
                   (test-assert (equal (provider-registration-name
                                       (model-provider-registration provider)) name)
                                "factory selection uses the explicit registration")
                   (test-assert (equal (config :model (provider-configuration provider)) "shared")
                                "factories receive the exact wire/catalog ID")
                   (test-assert (equal (config :model-provider (provider-configuration login)) name)
                                "authentication construction retains the selected provider")
                   (test-assert (= (config :context-window configuration)
                                   (if (equal name "selection-a") 11000 22000))
                                "context metadata comes from the selected provider")
                   (test-assert (equal (config :provider-endpoint configuration)
                                      (format nil "https://~A.invalid/completions" name))
                                "endpoint metadata comes from the selected provider")
                   (let ((same (configuration-copy configuration :model "shared"))
                         (other (configuration-copy configuration :model *default-model*))
                         (full (configuration-copy configuration :model "selection-b/shared")))
                     (test-assert (equal (config :model-provider same) name)
                                  "copying the same bare model retains its provider")
                     (test-assert (equal (config :model-provider other) "chatgpt")
                                  "a different model does not inherit an incompatible provider")
                     (test-assert (and (equal (config :model full) "shared")
                                      (equal (config :model-provider full) "selection-b"))
                                  "configuration overrides normalize qualified model IDs"))))
               (dolist (name '("selection-a" "selection-later"))
                 (let* ((model (format nil "~A/unlisted/model" name))
                        (configuration
                          (configuration-copy base :model model :model-provider name
                                                   :provider-validation-p nil)))
                   (test-assert (and (equal (config :model configuration) model)
                                     (equal (config :model-provider configuration) name))
                                "deferred configuration retains an undiscovered model/provider pair")
                   (test-assert (= (config :context-window configuration) *default-context-window*)
                                "undiscovered models use the default context window")
                   (test-assert (equal (configuration--reasoning-efforts-for model name)
                                       *supported-reasoning-efforts*)
                                "undiscovered models use default reasoning options")
                   (test-assert (equal (provider-model-endpoint model :provider name)
                                       (and (equal name "selection-a")
                                            "https://selection-a.invalid/completions"))
                                "registered provider metadata is available before model discovery")
                   (test-assert
                    (handler-case (progn (provider-create configuration) nil)
                      (model-selection-error () t))
                    "request provider construction still validates deferred selections"))))
         (platform-delete-directory-tree *platform* root :validate t :if-does-not-exist ':ignore)))))
  nil)

(-> test-provider-qualified-model-application () null)
(defun test-provider-qualified-model-application ()
  "Select through callable commands, list duplicate IDs, and reload durable selections."
  (provider-selection-tests--with-providers
   (lambda ()
     (let* ((configuration (test-configuration))
            (root (test-configuration-root configuration))
            (conversation (conversation-create configuration :identifier "qualified-model"))
            (registry (make-default-tool-registry))
            (worker (lisp-worker-create configuration))
            (terminal (make-instance 'scripted-terminal :columns 80))
            (ui (terminal-ui-create :terminal terminal))
            (application (make-instance 'application :configuration configuration
                                        :conversation conversation :provider (provider-create configuration)
                                        :tool-registry registry :worker worker :ui ui)))
       (unwind-protect
            (progn
              (application-operation-call application "model" "shared" :provider "selection-a")
              (test-assert (equal (config :model-provider (application-configuration application)) "selection-a")
                           "the callable keyword form selects its provider")
              (application-operation-call application "model" "selection-b/shared")
              (test-assert (and (equal (config :model (application-configuration application)) "shared")
                                (equal (config :model-provider (application-configuration application)) "selection-b"))
                           "a full ID produces canonical runtime settings")
              (let ((before (application-configuration application)))
                (test-assert (handler-case (progn (application-set-model application "shared" :provider "absent") nil)
                               (model-selection-error () t))
                             "invalid model changes signal a typed failure")
                (test-assert (eq before (application-configuration application))
                             "invalid selections do not replace the runtime"))
              (let ((items (append (application--model-items application :provider "selection-a")
                                   (application--model-items application :provider "selection-b"))))
                (test-assert (= (count "shared" items :key (lambda (item) (getf item :model)) :test #'equal) 2)
                             "both providers' duplicate IDs are offered")
                (test-assert (every (lambda (item) (equal (getf item :provider) "selection-a"))
                                    (application--model-items application :provider "selection-a"))
                             "the model picker filters by provider"))
              (let ((start (length (recording-terminal-output terminal))))
                (application-operation-call application "models" :provider "selection-a")
                (let ((listing (subseq (recording-terminal-output terminal) start)))
                  (test-assert (and (search "selection-a/shared" listing)
                                    (not (search "selection-b/shared" listing)))
                               "the callable models command filters by provider")))
              (setf (scripted-terminal-events terminal) (list :submit))
              (with-terminal-ui (active-ui ui)
                (declare (ignore active-ui))
                (multiple-value-bind (model provider)
                    (application--pick-model application :provider "selection-a")
                  (test-assert (and (equal model "shared") (equal provider "selection-a"))
                               "the filtered picker returns an exact model/provider pair")))
              (application-set-model application "hf:zai-org/GLM-5.3-Flash" :provider "selection-a")
              (let* ((saved (preferences-load-values configuration))
                     (loaded (apply #'make-configuration saved))
                     (restored (application--configuration-for-conversation configuration conversation)))
                (test-assert (and (equal (config :model loaded) "hf:zai-org/GLM-5.3-Flash")
                                  (equal (config :model-provider loaded) "selection-a"))
                             "global preferences reload the exact model/provider pair")
                (test-assert (equal (config :model-provider restored) "selection-a")
                             "conversation selection restores its provider"))
              (conversation-append-user-message conversation "hello")
              (let* ((loaded (conversation-load (conversation-pathname conversation)))
                     (restored (application--configuration-for-conversation configuration loaded)))
                (test-assert (and (equal (conversation-model loaded) "hf:zai-org/GLM-5.3-Flash")
                                  (equal (conversation-model-provider loaded) "selection-a")
                                  (equal (config :model-provider restored) "selection-a"))
                             "the conversation header reloads the selected provider"))
              (application-set-model application "deepseek/v4" :provider "selection-b")
              (let* ((loaded (conversation-load (conversation-pathname conversation)))
                     (restored (application--configuration-for-conversation configuration loaded)))
                (test-assert (and (equal (config :model restored) "deepseek/v4")
                                  (equal (config :model-provider restored) "selection-b"))
                             "configuration records retain explicit slash-ID collisions"))
              (application--install-configuration
               application (configuration-copy (application-configuration application)
                                                :model "shared" :model-provider "selection-a"))
              (application-set-reasoning-effort application "low")
              (let ((saved (preferences-load-values configuration)))
                (test-assert (and (equal (getf saved :model) "shared")
                                  (equal (getf saved :model-provider) "selection-a"))
                             "effort selection persists the accompanying provider/model pair")))
         (ignore-errors (terminal-ui-stop ui))
         (ignore-errors (tool-registry-close-runtime-state registry))
         (platform-delete-directory-tree *platform* root :validate t :if-does-not-exist ':ignore)))))
  nil)
